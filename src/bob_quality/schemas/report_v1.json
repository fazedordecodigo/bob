{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fazedordecodigo/bob/schemas/report-v1.json",
  "title": "bob report",
  "type": "object",
  "required": [
    "schema_version",
    "commit",
    "base",
    "generated_at",
    "tool_versions",
    "gates",
    "focus",
    "top_crap",
    "reproduce",
    "exit_code"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commit": { "type": "string" },
    "base": { "type": "string" },
    "generated_at": { "type": "string" },
    "tool_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["passed", "warn", "failed", "not_run"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "focus": { "type": "array" },
    "top_crap": { "type": "array" },
    "old_debt": { "type": "array" },
    "old_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "destination", "rule"],
        "properties": {
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "destination", "rule"],
        "properties": {
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "clones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "first_file",
          "first_start",
          "first_end",
          "second_file",
          "second_start",
          "second_end",
          "lines",
          "tokens"
        ],
        "properties": {
          "first_file": { "type": "string" },
          "first_start": { "type": "integer" },
          "first_end": { "type": "integer" },
          "second_file": { "type": "string" },
          "second_start": { "type": "integer" },
          "second_end": { "type": "integer" },
          "lines": { "type": "integer" },
          "tokens": { "type": "integer" },
          "similarity": { "type": ["number", "null"] },
          "kind": { "type": "string" }
        }
      }
    },
    "waivers": { "type": "array" },
    "survivors": { "type": "array" },
    "mutation": {
      "type": ["object", "null"],
      "properties": {
        "no_coverage": {
          "type": "object",
          "required": ["total", "functions"],
          "properties": {
            "total": { "type": "integer" },
            "functions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file", "function", "count"],
                "properties": {
                  "file": { "type": "string" },
                  "function": { "type": "string" },
                  "count": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    },
    "churn": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "unavailable" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "window_days", "ends_on", "files", "hotspots", "diffusion"],
          "properties": {
            "kind": { "const": "measured" },
            "window_days": { "type": "integer", "minimum": 1 },
            "ends_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "commits"],
                "properties": {
                  "path": { "type": "string" },
                  "commits": { "type": "integer", "minimum": 0 }
                }
              }
            },
            "hotspots": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["file", "function", "start_line", "cc", "commits", "hotspot"],
                "properties": {
                  "file": { "type": "string" },
                  "function": { "type": "string" },
                  "start_line": { "type": "integer" },
                  "cc": { "type": "integer" },
                  "commits": { "type": "integer", "minimum": 0 },
                  "hotspot": { "type": "integer" }
                }
              }
            },
            "diffusion": {
              "type": "object",
              "additionalProperties": false,
              "required": ["files", "modules"],
              "properties": {
                "files": { "type": "integer", "minimum": 0 },
                "modules": { "type": "integer", "minimum": 0 }
              }
            }
          }
        }
      ]
    },
    "reproduce": { "type": "string" },
    "exit_code": { "type": "integer" }
  }
}
