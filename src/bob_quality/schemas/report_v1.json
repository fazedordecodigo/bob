{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fazedordecodigo/bob/schemas/report-v1.json",
  "title": "bob report",
  "type": "object",
  "required": [
    "schema_version",
    "commit",
    "base",
    "generated_at",
    "tool_versions",
    "gates",
    "focus",
    "top_crap",
    "reproduce",
    "exit_code"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commit": { "type": "string" },
    "base": { "type": "string" },
    "generated_at": { "type": "string" },
    "tool_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["passed", "warn", "failed", "not_run"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "focus": { "type": "array" },
    "top_crap": { "type": "array" },
    "old_debt": { "type": "array" },
    "old_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "destination", "rule"],
        "properties": {
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "destination", "rule"],
        "properties": {
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "clones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "first_file",
          "first_start",
          "first_end",
          "second_file",
          "second_start",
          "second_end",
          "lines",
          "tokens"
        ],
        "properties": {
          "first_file": { "type": "string" },
          "first_start": { "type": "integer" },
          "first_end": { "type": "integer" },
          "second_file": { "type": "string" },
          "second_start": { "type": "integer" },
          "second_end": { "type": "integer" },
          "lines": { "type": "integer" },
          "tokens": { "type": "integer" },
          "similarity": { "type": ["number", "null"] },
          "kind": { "type": "string" }
        }
      }
    },
    "waivers": { "type": "array" },
    "survivors": { "type": "array" },
    "mutation": {
      "type": ["object", "null"],
      "properties": {
        "no_coverage": {
          "type": "object",
          "required": ["total", "functions"],
          "properties": {
            "total": { "type": "integer" },
            "functions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file", "function", "count"],
                "properties": {
                  "file": { "type": "string" },
                  "function": { "type": "string" },
                  "count": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    },
    "reproduce": { "type": "string" },
    "exit_code": { "type": "integer" },
    "test_smells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "line", "rule", "waiver"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "rule": { "type": "string" },
          "waiver": { "type": ["string", "null"] }
        }
      }
    }
  }
}
