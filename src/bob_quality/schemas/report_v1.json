{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/fazedordecodigo/bob/schemas/report-v1.json",
  "title": "bob report",
  "type": "object",
  "required": [
    "schema_version",
    "commit",
    "base",
    "generated_at",
    "tool_versions",
    "gates",
    "focus",
    "top_crap",
    "reproduce",
    "exit_code"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commit": { "type": "string" },
    "base": { "type": "string" },
    "generated_at": { "type": "string" },
    "tool_versions": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string" },
          "status": { "enum": ["passed", "warn", "failed", "not_run"] },
          "reason": { "type": ["string", "null"] }
        }
      }
    },
    "focus": { "type": "array" },
    "top_crap": { "type": "array" },
    "old_debt": { "type": "array" },
    "old_dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "destination", "rule"],
        "properties": {
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["origin", "destination", "rule"],
        "properties": {
          "origin": { "type": "string" },
          "destination": { "type": "string" },
          "rule": { "type": "string" }
        }
      }
    },
    "clones": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "first_file",
          "first_start",
          "first_end",
          "second_file",
          "second_start",
          "second_end",
          "lines",
          "tokens"
        ],
        "properties": {
          "first_file": { "type": "string" },
          "first_start": { "type": "integer" },
          "first_end": { "type": "integer" },
          "second_file": { "type": "string" },
          "second_start": { "type": "integer" },
          "second_end": { "type": "integer" },
          "lines": { "type": "integer" },
          "tokens": { "type": "integer" },
          "similarity": { "type": ["number", "null"] },
          "kind": { "type": "string" }
        }
      }
    },
    "waivers": { "type": "array" },
    "survivors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "blocking": { "type": "boolean" }
        }
      }
    },
    "mutation": {
      "type": ["object", "null"],
      "properties": {
        "no_coverage": {
          "type": "object",
          "required": ["total", "functions"],
          "properties": {
            "total": { "type": "integer" },
            "functions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["file", "function", "count"],
                "properties": {
                  "file": { "type": "string" },
                  "function": { "type": "string" },
                  "count": { "type": "integer" }
                }
              }
            }
          }
        }
      }
    },
    "supply": {
      "type": "object",
      "required": ["measured", "skipped", "findings"],
      "properties": {
        "measured": {
          "type": "array",
          "items": { "enum": ["python", "typescript"] }
        },
        "skipped": {
          "type": "array",
          "items": { "enum": ["python", "typescript"] }
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "effect", "waiver"],
            "properties": {
              "kind": { "enum": ["missing", "undeclared", "advisory", "unverified"] },
              "effect": { "enum": ["block", "warn", "waived"] },
              "question": { "enum": ["existence", "advisory"] },
              "index": { "enum": ["pypi", "npm"] },
              "name": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" },
              "module": { "type": "string" },
              "advisory": { "type": ["string", "null"] },
              "severity": { "enum": ["CRITICAL", "HIGH", "MODERATE", "LOW"] },
              "cause": { "enum": ["timeout", "dns", "undecided", "no_severity"] },
              "waiver": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "line", "rule_id"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "rule_id": { "type": "string" }
        }
      }
    },
    "reproduce": { "type": "string" },
    "exit_code": { "type": "integer" },
    "typing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absent", "checkers", "findings"],
      "properties": {
        "absent": {
          "type": "array",
          "items": { "enum": ["python", "typescript"] }
        },
        "checkers": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["language", "tool", "outcome"],
                "properties": {
                  "language": { "enum": ["python", "typescript"] },
                  "tool": { "enum": ["mypy", "pyright", "tsc"] },
                  "outcome": { "const": "measured" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["language", "tool", "outcome", "reason"],
                "properties": {
                  "language": { "enum": ["python", "typescript"] },
                  "tool": { "enum": ["mypy", "pyright", "tsc"] },
                  "outcome": { "const": "unmeasured" },
                  "reason": {
                    "enum": [
                      "missing_executable",
                      "unparseable_output",
                      "exit_outside_measurement",
                      "crashed"
                    ]
                  }
                }
              }
            ]
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "disposition", "file", "line", "code", "tool", "waiver_id"],
                "properties": {
                  "kind": { "const": "diagnostic" },
                  "disposition": { "enum": ["blocking", "waived", "off_diff"] },
                  "file": { "type": "string" },
                  "line": { "type": "integer" },
                  "code": { "type": "string" },
                  "tool": { "enum": ["mypy", "pyright", "tsc"] },
                  "waiver_id": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "disposition", "file", "line", "code", "waiver_id"],
                "properties": {
                  "kind": { "const": "escape" },
                  "disposition": { "enum": ["blocking", "waived"] },
                  "file": { "type": "string" },
                  "line": { "type": "integer" },
                  "code": {
                    "enum": ["Any", "type: ignore", "as any", "@ts-ignore", "@ts-expect-error"]
                  },
                  "waiver_id": { "type": "string" }
                }
              }
            ]
          }
        }
      }
    },
    "dead_code": {
      "type": "object",
      "required": ["symbols"],
      "properties": {
        "symbols": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["file", "line", "name", "kind", "language"],
            "properties": {
              "file": { "type": "string" },
              "line": { "type": "integer", "minimum": 1 },
              "name": { "type": "string" },
              "kind": { "type": "string" },
              "language": { "enum": ["python", "typescript"] },
              "confidence": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
              "waiver": { "type": ["string", "null"] }
            }
          }
        }
      }
    }
  }
}
